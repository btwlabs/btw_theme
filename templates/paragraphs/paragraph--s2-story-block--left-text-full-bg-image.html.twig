{#
/**
 * @file
 * Left text full bg image story block.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{% set has_parallax = 'parallax' in paragraph.field_ff_sb_use_parallax.0.value %}
{% set image_effect = ('fixed' in paragraph.field_ff_sb_use_parallax.0.value ? 'fixed' : (has_parallax ? 'parallax-item' : 'no-effect')) %}
{% set has_bg_video = not paragraph.field_hero_video.0 is empty %}
{% set mobile_image_field = not paragraph.field_hero_mobile_image is empty ? paragraph.field_hero_mobile_image : paragraph.field_story_block_images %}
{% set classes = [
  'section',
  'section-story-block',
  paragraph.field_story_block_classes.0.value,
  has_parallax ? 'has-parallax',
  has_bg_video ? 'has-bg-video',
  'paragraph',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  (not paragraph.field_story_block_extra_image is empty) ? 'has-extra-image'
] %}

  {% set view_mode = view_mode|replace({'_':'-'}) %}
  <section {{ attributes.addClass(classes) }}>
    {{ title_prefix }}
    {{ title_suffix }}
    <div class="story-block {{ view_mode }} {{ paragraph.field_story_block_image_overlay_.0.value }} clearfix">

      {% if has_bg_video %}
        {% set video_media = paragraph.field_hero_video.entity %}
        {% set video_file = video_media.field_media_video_file.entity %}
        {% set poster_file = paragraph.field_story_block_images.entity %}
        <!-- Start: Full BG Video -->
        <video class="story-block-bg-video d-none d-md-block {{ image_effect }}" autoplay muted loop playsinline
          {% if poster_file %}poster="{{ file_url(poster_file.uri.value) }}"{% endif %}>
          {% if video_file %}
            <source src="{{ file_url(video_file.uri.value) }}" type="{{ video_file.filemime.value }}">
          {% endif %}
        </video>
        <!-- End: Full BG Video -->
        {% elseif not paragraph.field_story_block_images is empty %}

        {# Ensure responsive_bg_image_formatter runs so its <style> tag is attached. #}
        {% if content.field_story_block_images is defined %}
          <div class="visually-hidden">{{ content.field_story_block_images }}</div>
        {% endif %}

        {{ content.html_head }}

        <!-- Start: Full BG Image -->
        <div class="lazy-load-bg-image d-none d-md-block {{ image_effect }}"></div>
        <!-- End: Full BG Image -->
      {% endif %}

      <div class="image-overlay"></div>
      <div class="story-block-inner" >

          <div class="group-left">
            {% if not paragraph.field_story_block_images.0 is empty %}
              <div class="story-block-mobile-image">
                <img src="{{ base_url ~ file_url(paragraph.field_story_block_images.0.entity.fileuri | image_style('story_block_small_fp')) }}" alt="{{ paragraph.field_story_block_images.0.alt }}" typeof="foaf:Image">
              </div>
            {% endif %}

            <div class="text-wrapper">
              {% if not paragraph.field_title_eyebrow.0.value is empty %}
                <div class="title-eyebrow">
                  {{ content.field_title_eyebrow }}
                </div>
            {% endif %}
            {% if not paragraph.field_title.0.value is empty %}
                {{ content.field_title }}
                {% if not paragraph.field_text_title.0.value is empty %}
                    {{ content.field_text_title }}
                {% endif %}
              {% endif %}
              {% if not paragraph.field_story_block_text.0.value is empty %}
                <div class="story-block-text">
                  <div>
                    {{ content.field_story_block_text }}
                  </div>
                </div>
              {% endif %}
              {% if not paragraph.field_story_block_link is empty or not paragraph.field_story_block_video is empty %}
                <div class="story-block-link-wrapper">
                {% if not paragraph.field_story_block_link is empty %}
                  <div class="story-block-link">
                    {{ content.field_story_block_link }}
                  </div>
                {% endif %}
                {% if not paragraph.field_story_block_video is empty %}
                  <div class="story-block-video">
                    {{ content.field_story_block_video }}
                  </div>
                {% endif %}
                </div>
              {% endif %}
            </div>
          </div>

          <div class="group-right">
            {% if not paragraph.field_story_block_extra_image.0 is empty %}
              <div class="story-block-extra-image">
               {{ content.field_story_block_extra_image }}
              </div>
            {% endif %}
          </div>

      </div>
    </div>
  </section>


